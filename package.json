{
  "name": "ahmodus-api",
  "version": "0.1.0",
  "description": "AHModus Dynamic AI Rule Engine API",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\" --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.config.ts\" --no-error-on-unmatched-pattern",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "drizzle-orm": "0.45.2",
    "jsep": "1.4.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "15.15.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
